# Variables privadas para configurar en Vercel
URBANO_PAYMENT_PIN=REEMPLAZAR_EN_VERCEL
URBANO_SESSION_SECRET=GENERAR_UN_SECRETO_ALEATORIO_DE_32_O_MAS_CARACTERES
URBANO_PAYMENT_ACCOUNTS_JSON={"Yape":"NUMERO","Plin":"NUMERO","BBVA":"CUENTA","BCP":"CUENTA","Interbank":"CUENTA","Scotiabank":"CUENTA"}

# Obligatorio para 3 intentos / bloqueo 15 minutos por IP.
# Obtén estos valores desde la integración Upstash Redis de Vercel.
UPSTASH_REDIS_REST_URL=https://TU-REDIS.upstash.io
UPSTASH_REDIS_REST_TOKEN=TU_TOKEN_PRIVADO
